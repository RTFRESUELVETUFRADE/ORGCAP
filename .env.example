# Resend (https://resend.com) — para el formulario de contacto
RESEND_API_KEY=
# Debe ser una dirección del dominio verificado en Resend, p.ej. "ORGCAP Web <web@orgcap.cl>"
# Mientras el dominio no esté verificado, usa "ORGCAP Web <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="ORGCAP Web <onboarding@resend.dev>"
# A qué correo llegan los mensajes del formulario
CONTACT_TO_EMAIL=contacto@orgcap.cl
